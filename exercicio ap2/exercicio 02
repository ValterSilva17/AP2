def calcular_producao(x):
    
    if x < 0:
        return 0
   
   
    producao = -(x**2) + (10 * x) + 50
    return producao

try:
    num_maquinas = int(input("Digite o número de máquinas: "))
    resultado = calcular_producao(num_maquinas)
    print(f"A produção total para {num_maquinas} máquinas é: {resultado}")
except ValueError:
    print("Por favor, digite um número inteiro válido.")
